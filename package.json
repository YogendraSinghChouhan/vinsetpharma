{
  "name": "vinsent-pharma",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "check": "biome check",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
