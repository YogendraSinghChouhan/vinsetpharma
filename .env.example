S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
NEXT_PUBLIC_S3_PUBLIC_URL=

# Quotes & Resend Email
RESEND_API_KEY=
QUOTE_NOTIFICATION_EMAIL=
QUOTE_FROM_EMAIL=
